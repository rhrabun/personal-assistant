BACKUP_PATHS=(
  "{{ data_dir }}"
)

EXCLUDE_PATHS=(
  # hermes toolchain, rebuilt from the image on container start
  "installs"
  "lazy-packages"
  "bin"
  "tools"
  "lsp"
  ".cua-driver"
  # caches, scratch, browser profiles
  "*cache*"
  "*.npm"
  "*.local"
  "*node_modules*"
  ".config"
  ".pki"
  # logs, and the ~/code bind mount
  "logs"
  "code"
  "core.*"
)

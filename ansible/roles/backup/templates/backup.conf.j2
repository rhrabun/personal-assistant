BACKUP_PATHS=(
  "{{ data_dir }}"
)

EXCLUDE_PATHS=(
  "installs"
  "lazy-packages"
  "bin"
  "tools"
  "lsp"
  ".cua-driver"
  "*cache*"
  "*.npm"
  "*.local"
  "*node_modules*"
  ".config"
  ".pki"
  "logs"
  "code"
  "core.*"
  # live sqlite excluded;
  # .dbsnap/*.sqlite holds the consistent dump written by restic-db-dump.py
  "*.db"
  "*.db-wal"
  "*.db-shm"
)
